   3.7852365998683977`*^9, 3.7852366267058506`*^9}, {3.9435081956491203`*^9, 
   3.9435082105868387`*^9}},ExpressionUUID->"b5193241-6d59-4683-b9f3-\
84049c03f1aa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", " ", "[", "x_", "]"}], ":=", 
  RowBox[{"x", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "2"}], ")"}], "^", "2"}], "/", 
    RowBox[{"(", 
     RowBox[{
